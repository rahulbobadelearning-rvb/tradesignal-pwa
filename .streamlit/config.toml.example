# ── Example Streamlit config ────────────────────────────────────────────────
# This file documents the security settings used by the app.
# The REAL config.toml is generated by: python scripts/setup_security.py
# It is gitignored because it contains machine-specific absolute paths.
#
# To generate your own config:
#   python scripts/setup_security.py
# ────────────────────────────────────────────────────────────────────────────

[server]
# Bind to loopback only — refuses connections from the network
address = "127.0.0.1"

# TLS certificate (generated by setup_security.py)
sslCertFile = "/absolute/path/to/certs/cert.pem"
sslKeyFile  = "/absolute/path/to/certs/key.pem"

headless = true
enableXsrfProtection = true
enableCORS = false

[browser]
gatherUsageStats = false
serverAddress = "localhost"

[client]
# Never show Python stack traces in the browser
showErrorDetails = false

# Hide the Deploy button
toolbarMode = "minimal"
